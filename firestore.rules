rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCompanyUser() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.trim().lower()
          .matches('[^@]+@kholidaymaps[.]com');
    }

    function ownsProfile(uid) {
      return isCompanyUser() && request.auth.uid == uid;
    }

    function isActiveAdmin() {
      // Authorize against the stored profile, never the proposed write or UI.
      return isCompanyUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function validProfile(data, uid) {
      let fields = [
        'uid', 'email', 'displayName', 'photoUrl',
        'role', 'status', 'createdAt', 'lastLoginAt'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.uid is string
        && data.uid == uid
        && data.email is string
        && data.email == data.email.trim().lower()
        && data.email.matches('[^@]+@kholidaymaps[.]com')
        && (data.displayName == null || data.displayName is string)
        && (data.photoUrl == null || data.photoUrl is string)
        && data.role in ['agent', 'admin']
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function canUpdateOwnProfile(uid) {
      return ownsProfile(uid)
        && resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email.trim().lower()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'lastLoginAt'])
        && request.resource.data.lastLoginAt == request.time;
    }

    function canAdministerProfile() {
      // Identity and login metadata stay immutable through this permission.
      return isActiveAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'status']);
    }

    match /users/{uid} {
      // Inactive users can resolve their own status, but cannot edit it.
      allow get: if ownsProfile(uid) || isActiveAdmin();
      allow list: if isActiveAdmin();

      allow create: if ownsProfile(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.email == request.auth.token.email.trim().lower()
        && request.resource.data.role == 'agent'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if validProfile(request.resource.data, uid)
        && (canUpdateOwnProfile(uid) || canAdministerProfile());

      allow delete: if false;
    }

    function isActiveAgent() {
      return isCompanyUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function validClient(data) {
      let required = [
        'firstName', 'lastName', 'mobileNumber',
        'createdByUid', 'createdAt', 'updatedAt'
      ];
      let optional = ['email', 'city', 'company'];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required.concat(optional))
        && data.firstName is string && data.firstName.trim().size() > 0
        && data.lastName is string && data.lastName.trim().size() > 0
        && data.mobileNumber is string && data.mobileNumber.trim().size() > 0
        && data.createdByUid is string && data.createdByUid.size() > 0
        && (data.get('email', null) == null || data.email is string)
        && (data.get('city', null) == null || data.city is string)
        && (data.get('company', null) == null || data.company is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function canAccessClient() {
      // Agent list queries must constrain createdByUid; rules are not filters.
      return isActiveAdmin()
        || (isActiveAgent() && resource.data.createdByUid == request.auth.uid);
    }

    match /clients/{clientId} {
      allow get, list: if canAccessClient();

      // Admins retain Agent creation abilities, but cannot assign another owner.
      allow create: if (isActiveAgent() || isActiveAdmin())
        && validClient(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canAccessClient()
        && validClient(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'mobileNumber', 'email', 'city', 'company',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function validTripIdentity(value) {
      return value is string
        && value.size() > 0
        && value == value.trim()
        && !value.matches('.*[/].*')
        && value != '.' && value != '..';
    }

    function validTrip(data) {
      let fields = [
        'clientId', 'clientFirstName', 'clientLastName', 'tripName',
        'destinations', 'travelStartDate', 'numberOfNights',
        'adults', 'children', 'infants', 'hotelCategory', 'tripType',
        'status', 'ownerUid', 'createdByUid', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && validTripIdentity(data.clientId)
        && validTripIdentity(data.ownerUid)
        && validTripIdentity(data.createdByUid)
        && data.clientFirstName is string && data.clientFirstName.trim().size() > 0
        && data.clientLastName is string && data.clientLastName.trim().size() > 0
        && data.tripName is string && data.tripName.trim().size() > 0
        && data.destinations is list && data.destinations.size() > 0
        && data.travelStartDate is timestamp
        && data.numberOfNights is int && data.numberOfNights >= 1
        && data.adults is int && data.adults >= 1
        && data.children is int && data.children >= 0
        && data.infants is int && data.infants >= 0
        && data.hotelCategory in ['3_star', '4_star', '5_star', 'luxury']
        && data.tripType in ['fit', 'business', 'corporate', 'groups']
        && data.status in [
          'draft', 'quote_prepared', 'sent_to_client', 'under_discussion',
          'revised', 'client_approved', 'on_hold', 'confirmed',
          'cancelled', 'lost', 'travel_completed'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function canCreateTripForClient(clientId) {
      let clientPath = /databases/$(database)/documents/clients/$(clientId);
      return exists(clientPath)
        && (isActiveAdmin()
          || get(clientPath).data.createdByUid == request.auth.uid);
    }

    function canAccessTrip() {
      // Agent queries must constrain current ownerUid, not original creator.
      return isActiveAdmin()
        || (isActiveAgent() && resource.data.ownerUid == request.auth.uid);
    }

    match /trips/{tripId} {
      allow get, list: if canAccessTrip();

      allow create: if (isActiveAgent() || isActiveAdmin())
        && validTrip(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && canCreateTripForClient(request.resource.data.clientId);

      // Same brief-only update boundary for Agents and Admins. The Client link
      // and creation-time name snapshot stay fixed, matching TripRepository.
      // Ownership, creator, creation time and status are not editable here.
      allow update: if canAccessTrip()
        && validTrip(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tripName', 'destinations', 'travelStartDate', 'numberOfNights',
          'adults', 'children', 'infants', 'hotelCategory', 'tripType', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function validSupplier(data) {
      let fields = [
        'name', 'contacts', 'destinationCoverage', 'serviceCategories',
        'status', 'createdByUid', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.name is string && data.name.trim().size() > 0
        // Detailed contact validation stays in the shared domain validators.
        && data.contacts is list
        && data.destinationCoverage is list
        && data.serviceCategories is list
        && data.serviceCategories.hasOnly([
          'dmc', 'hotels', 'transfers', 'activities', 'visa', 'flights', 'other'
        ])
        && data.status in ['active', 'inactive']
        && data.createdByUid is string && data.createdByUid.trim().size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /suppliers/{supplierId} {
      // Company-wide master: creator is audit metadata, never ownership.
      allow get, list: if isActiveAgent() || isActiveAdmin();

      allow create: if (isActiveAgent() || isActiveAdmin())
        && validSupplier(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Neither role can change status or creation metadata through this rule.
      allow update: if (isActiveAgent() || isActiveAdmin())
        && validSupplier(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'contacts', 'destinationCoverage', 'serviceCategories',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
