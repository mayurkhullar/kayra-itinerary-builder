rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCompanyUser() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.trim().lower()
          .matches('[^@]+@kholidaymaps[.]com');
    }

    function ownsProfile(uid) {
      return isCompanyUser() && request.auth.uid == uid;
    }

    function isActiveAdmin() {
      // Authorize against the stored profile, never the proposed write or UI.
      return isCompanyUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function validProfile(data, uid) {
      let fields = [
        'uid', 'email', 'displayName', 'photoUrl',
        'role', 'status', 'createdAt', 'lastLoginAt'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.uid is string
        && data.uid == uid
        && data.email is string
        && data.email == data.email.trim().lower()
        && data.email.matches('[^@]+@kholidaymaps[.]com')
        && (data.displayName == null || data.displayName is string)
        && (data.photoUrl == null || data.photoUrl is string)
        && data.role in ['agent', 'admin']
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function canUpdateOwnProfile(uid) {
      return ownsProfile(uid)
        && resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email.trim().lower()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'lastLoginAt'])
        && request.resource.data.lastLoginAt == request.time;
    }

    function canAdministerProfile() {
      // Identity and login metadata stay immutable through this permission.
      return isActiveAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'status']);
    }

    match /users/{uid} {
      // Inactive users can resolve their own status, but cannot edit it.
      allow get: if ownsProfile(uid) || isActiveAdmin();
      allow list: if isActiveAdmin();

      allow create: if ownsProfile(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.email == request.auth.token.email.trim().lower()
        && request.resource.data.role == 'agent'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if validProfile(request.resource.data, uid)
        && (canUpdateOwnProfile(uid) || canAdministerProfile());

      allow delete: if false;
    }

    function isActiveAgent() {
      return isCompanyUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function validClient(data) {
      let required = [
        'firstName', 'lastName', 'mobileNumber',
        'createdByUid', 'createdAt', 'updatedAt'
      ];
      let optional = ['email', 'city', 'company'];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required.concat(optional))
        && data.firstName is string && data.firstName.trim().size() > 0
        && data.lastName is string && data.lastName.trim().size() > 0
        && data.mobileNumber is string && data.mobileNumber.trim().size() > 0
        && data.createdByUid is string && data.createdByUid.size() > 0
        && (data.get('email', null) == null || data.email is string)
        && (data.get('city', null) == null || data.city is string)
        && (data.get('company', null) == null || data.company is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function canAccessClient() {
      // Agent list queries must constrain createdByUid; rules are not filters.
      return isActiveAdmin()
        || (isActiveAgent() && resource.data.createdByUid == request.auth.uid);
    }

    match /clients/{clientId} {
      allow get, list: if canAccessClient();

      // Admins retain Agent creation abilities, but cannot assign another owner.
      allow create: if (isActiveAgent() || isActiveAdmin())
        && validClient(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if canAccessClient()
        && validClient(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'mobileNumber', 'email', 'city', 'company',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
