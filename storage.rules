rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isCompanyUser() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.trim().lower()
          .matches('[^@]+@kholidaymaps[.]com');
    }

    function profileCanAccessTrip(profile, trip) {
      return profile.status == 'active'
        && (profile.role == 'admin'
          || (profile.role == 'agent' && trip.ownerUid == request.auth.uid));
    }

    function canAccessTrip(tripId) {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      let tripPath = /databases/(default)/documents/trips/$(tripId);
      // Only two distinct Firestore documents; exists/get reuse cached reads.
      // Trip existence is required even for Admins.
      return firestore.exists(userPath)
        && firestore.exists(tripPath)
        && profileCanAccessTrip(
          firestore.get(userPath).data,
          firestore.get(tripPath).data
        );
    }

    function isSupportedSourceFile() {
      return request.resource.contentType != null
        && request.resource.contentType is string
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv',
          'text/plain',
          'image/jpeg',
          'image/png',
          'image/webp'
        ]
        && request.resource.size <= 25 * 1024 * 1024;
    }

    // Single-segment fileName deliberately excludes nested source-file paths.
    match /trips/{tripId}/supplier_sources/{sourceFileId}/{fileName} {
      allow read: if fileName.size() > 0
        && isCompanyUser()
        && canAccessTrip(tripId);

      allow create: if fileName.size() > 0
        && isSupportedSourceFile()
        && isCompanyUser()
        && canAccessTrip(tripId);

      // Preserve original evidence, including its metadata.
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
